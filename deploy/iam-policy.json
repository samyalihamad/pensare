{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PensareObjectRW",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/contexts/*",
        "arn:aws:s3:::__BUCKET__/web/*"
      ]
    },
    {
      "Sid": "PensareList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringLike": { "s3:prefix": ["contexts/*", "web/*"] }
      }
    }
  ]
}
